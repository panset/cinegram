load("@gazelle//:def.bzl", "gazelle")

# gazelle:prefix github.com/tejaspanse/cinegram
gazelle(name = "gazelle")

# The canonical licence. The VS Code extension keeps a copy, because a .vsix
# holds nothing outside the extension folder; //editors/vscode:assets_test is
# what keeps the two equal.
exports_files(["LICENSE"])

# The inputs and the committed outputs of the generated half of the website.
# //site:site_test regenerates the latter from the former and diffs, so a
# commit that changes an example or the README without re-running
# `bazel run //site:sync` fails the build.
#
# Zensical turns www/ into the published site, and Bazel cannot run Zensical —
# it is a Python package, and this repository takes no dependency it cannot
# fetch itself. What Bazel can do is guarantee that Zensical's *input* is
# current, which is the half that goes stale.
filegroup(
    name = "examples",
    srcs = ["//examples:all_files"],
    visibility = ["//site:__pkg__"],
)

filegroup(
    name = "readme",
    srcs = ["README.md"],
    visibility = ["//site:__pkg__"],
)

# Zensical will not report an extra_css that points at nothing, so
# //site:site_test reads the config and checks it against the embed kit.
filegroup(
    name = "zensical_config",
    srcs = ["zensical.toml"],
    visibility = ["//site:__pkg__"],
)

filegroup(
    name = "www",
    srcs = glob(
        ["www/**"],
        # Empty until the first `bazel run //site:sync` has run; the test
        # reports that state itself, more helpfully than a glob error would.
        allow_empty = True,
    ),
    visibility = ["//site:__pkg__"],
)
