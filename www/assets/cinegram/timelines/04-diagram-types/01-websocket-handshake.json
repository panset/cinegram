{
  "version": 2,
  "root": "01-websocket-handshake",
  "views": [
    {
      "id": "01-websocket-handshake",
      "title": "the upgrade",
      "diagram": {
        "type": "sequenceDiagram",
        "mermaid": "%% A WebSocket upgrade, as a sequenceDiagram.\n%% ---\n%% This example exists to prove a claim the architecture makes: a second\n%% diagram type costs one parser and nothing else. Every feature used below —\n%% step `desc`, `gauge`, `focus`, a `click` that drills into a flowchart — was\n%% written for flowcharts and none of it needed changing.\n%% ---\n%% Note the flows carry no `label`: a sequence diagram already draws the\n%% message text, so a label would print a second copy on top of it.\nsequenceDiagram\n  participant C as Browser\n  participant L as Load Balancer\n  participant S as WebSocket Server\n\n  C-\u003e\u003eL: GET /socket (Upgrade: websocket)\n  L-\u003e\u003eS: forward upgrade\n  S--\u003e\u003eC: 101 Switching Protocols\n  C-\u003e\u003eS: ping\n  S--\u003e\u003eC: pong\n  C-\u003e\u003eS: close\n\n"
      },
      "nodes": [
        {
          "id": "C",
          "label": "Browser",
          "shape": "actor"
        },
        {
          "id": "L",
          "label": "Load Balancer",
          "shape": "actor"
        },
        {
          "id": "S",
          "label": "WebSocket Server",
          "shape": "actor"
        }
      ],
      "groups": [],
      "edges": [
        {
          "id": "e0",
          "from": "C",
          "to": "L",
          "label": "GET /socket (Upgrade: websocket)",
          "style": "normal",
          "head": "arrow"
        },
        {
          "id": "e1",
          "from": "L",
          "to": "S",
          "label": "forward upgrade",
          "style": "normal",
          "head": "arrow"
        },
        {
          "id": "e2",
          "from": "S",
          "to": "C",
          "label": "101 Switching Protocols",
          "style": "dotted",
          "head": "arrow"
        },
        {
          "id": "e3",
          "from": "C",
          "to": "S",
          "label": "ping",
          "style": "normal",
          "head": "arrow"
        },
        {
          "id": "e4",
          "from": "S",
          "to": "C",
          "label": "pong",
          "style": "dotted",
          "head": "arrow"
        },
        {
          "id": "e5",
          "from": "C",
          "to": "S",
          "label": "close",
          "style": "normal",
          "head": "arrow"
        }
      ],
      "scenarios": [
        {
          "id": "s0",
          "name": "the upgrade",
          "duration": 3200,
          "speed": 1,
          "loop": false,
          "autoplay": false,
          "steps": [
            {
              "id": "ask",
              "name": "The browser asks to change protocol",
              "desc": "A WebSocket connection starts life as an ordinary HTTP request. That is the whole trick: it travels through proxies and firewalls that would never have let a new protocol through on its own.",
              "start": 0,
              "end": 700,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 0,
                  "end": 700,
                  "edge": "e0",
                  "from": "C",
                  "to": "L"
                },
                {
                  "kind": "highlight",
                  "start": 0,
                  "end": 700,
                  "target": "L",
                  "style": "active"
                }
              ]
            },
            {
              "id": "forward",
              "name": "The load balancer passes it through",
              "desc": "A proxy that does not understand the upgrade header will happily strip it, which is why this hop is where most WebSocket deployments break.",
              "start": 700,
              "end": 1300,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 700,
                  "end": 1300,
                  "edge": "e1",
                  "from": "L",
                  "to": "S"
                }
              ]
            },
            {
              "id": "switch",
              "name": "The server agrees to switch",
              "desc": "101 is the only status code that means the connection is no longer HTTP. From here the same TCP socket carries frames in both directions, and neither side has to ask before sending.",
              "start": 1300,
              "end": 2100,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 1300,
                  "end": 2100,
                  "edge": "e2",
                  "from": "S",
                  "to": "C",
                  "style": "response"
                }
              ]
            },
            {
              "id": "keepalive",
              "name": "Frames travel both ways",
              "desc": "Ping and pong are not application messages — they are how each side finds out the other is still there, on a connection that may sit silent for hours.",
              "start": 2100,
              "end": 2600,
              "tracks": [
                {
                  "kind": "focus",
                  "start": 2100,
                  "end": 2600,
                  "target": "S"
                },
                {
                  "kind": "flow",
                  "start": 2100,
                  "end": 2600,
                  "edge": "e3",
                  "from": "C",
                  "to": "S"
                },
                {
                  "kind": "flow",
                  "start": 2100,
                  "end": 2600,
                  "edge": "e4",
                  "from": "S",
                  "to": "C",
                  "style": "response"
                }
              ]
            },
            {
              "id": "close",
              "name": "The browser closes it",
              "desc": "A close frame is a request, not a fact. The connection is not gone until both sides have sent one, which is why a well-behaved client waits rather than dropping the socket.",
              "start": 2600,
              "end": 3200,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 2600,
                  "end": 3200,
                  "edge": "e5",
                  "from": "C",
                  "to": "S"
                }
              ]
            }
          ],
          "persistent": [
            {
              "kind": "set",
              "start": 1300,
              "end": 2600,
              "target": "S",
              "label": "upgraded",
              "value": "open",
              "color": "#16a34a"
            },
            {
              "kind": "gauge",
              "start": 1300,
              "end": 2600,
              "target": "S",
              "label": "open",
              "value": "1"
            },
            {
              "kind": "gauge",
              "start": 2600,
              "end": 3200,
              "target": "S",
              "label": "open",
              "value": "0"
            }
          ]
        }
      ],
      "bindings": [
        {
          "source": "S",
          "kind": "view",
          "view": "pod-a",
          "label": "What the server is doing"
        }
      ]
    },
    {
      "id": "pod-a",
      "title": "Inside the server",
      "diagram": {
        "type": "flowchart",
        "direction": "LR",
        "mermaid": "%% What Pod A does with a request once kube-proxy has picked it.\n%% Reached by clicking Pod A in 01-basics/01-k8s-request.dgm — and by clicking\n%% the server in 04-diagram-types/01-websocket-handshake.dgm, which is why this\n%% file sits at the root rather than inside either folder. Previewable alone.\nflowchart LR\n  in[Request from Service]\n  subgraph pod[Pod A]\n    proxy[Envoy Sidecar]\n    app[Order API Container]\n    cache[(Local Cache)]\n  end\n  db[(Orders Postgres)]\n  in --\u003e proxy\n  proxy --\u003e app\n  app --\u003e cache\n  app --\u003e db\n"
      },
      "nodes": [
        {
          "id": "in",
          "label": "Request from Service",
          "shape": "rect"
        },
        {
          "id": "proxy",
          "label": "Envoy Sidecar",
          "shape": "rect",
          "group": "pod"
        },
        {
          "id": "app",
          "label": "Order API Container",
          "shape": "rect",
          "group": "pod"
        },
        {
          "id": "cache",
          "label": "Local Cache",
          "shape": "cylinder",
          "group": "pod"
        },
        {
          "id": "db",
          "label": "Orders Postgres",
          "shape": "cylinder"
        }
      ],
      "groups": [
        {
          "id": "pod",
          "label": "Pod A",
          "children": [
            "proxy",
            "app",
            "cache"
          ]
        }
      ],
      "edges": [
        {
          "id": "e0",
          "from": "in",
          "to": "proxy",
          "style": "normal",
          "head": "arrow"
        },
        {
          "id": "e1",
          "from": "proxy",
          "to": "app",
          "style": "normal",
          "head": "arrow"
        },
        {
          "id": "e2",
          "from": "app",
          "to": "cache",
          "style": "normal",
          "head": "arrow"
        },
        {
          "id": "e3",
          "from": "app",
          "to": "db",
          "style": "normal",
          "head": "arrow"
        }
      ],
      "scenarios": [
        {
          "id": "s0",
          "name": "fetch orders",
          "duration": 3650,
          "speed": 1,
          "loop": true,
          "autoplay": false,
          "steps": [
            {
              "id": "admit",
              "name": "Sidecar admits the request",
              "start": 0,
              "end": 500,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 0,
                  "end": 500,
                  "edge": "e0",
                  "from": "in",
                  "to": "proxy",
                  "label": "GET /api/orders"
                },
                {
                  "kind": "highlight",
                  "start": 0,
                  "end": 500,
                  "target": "proxy",
                  "style": "active"
                }
              ]
            },
            {
              "id": "forward",
              "name": "Proxy forwards to the app container",
              "start": 500,
              "end": 900,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 500,
                  "end": 900,
                  "edge": "e1",
                  "from": "proxy",
                  "to": "app",
                  "label": "localhost:8080"
                },
                {
                  "kind": "note",
                  "start": 500,
                  "end": 900,
                  "target": "proxy",
                  "text": "mTLS terminated\nrate limit ok"
                }
              ]
            },
            {
              "id": "lookup",
              "name": "App checks its local cache first",
              "start": 900,
              "end": 1250,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 900,
                  "end": 1250,
                  "edge": "e2",
                  "from": "app",
                  "to": "cache",
                  "label": "orders:u42"
                },
                {
                  "kind": "note",
                  "start": 900,
                  "end": 1250,
                  "target": "cache",
                  "text": "miss"
                }
              ]
            },
            {
              "id": "query",
              "name": "Cache miss, so the app queries Postgres",
              "start": 1250,
              "end": 1950,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 1250,
                  "end": 1950,
                  "edge": "e3",
                  "from": "app",
                  "to": "db",
                  "label": "SELECT * FROM orders"
                },
                {
                  "kind": "highlight",
                  "start": 1250,
                  "end": 1950,
                  "target": "db",
                  "style": "busy"
                }
              ]
            },
            {
              "id": "rows",
              "name": "Postgres returns the rows",
              "start": 1950,
              "end": 2550,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 1950,
                  "end": 2550,
                  "edge": "e3",
                  "from": "db",
                  "to": "app",
                  "reverse": true,
                  "label": "14 rows",
                  "style": "response"
                },
                {
                  "kind": "highlight",
                  "start": 1950,
                  "end": 2450,
                  "target": "app",
                  "style": "busy"
                }
              ]
            },
            {
              "id": "fill",
              "name": "App fills the cache and answers",
              "start": 2550,
              "end": 2850,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 2550,
                  "end": 2850,
                  "edge": "e2",
                  "from": "app",
                  "to": "cache",
                  "label": "SET orders:u42"
                },
                {
                  "kind": "note",
                  "start": 2550,
                  "end": 2850,
                  "target": "app",
                  "text": "200 OK in 14ms"
                }
              ]
            },
            {
              "id": "reply",
              "name": "Response leaves the pod",
              "start": 2850,
              "end": 3650,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 2850,
                  "end": 3250,
                  "edge": "e1",
                  "from": "app",
                  "to": "proxy",
                  "reverse": true,
                  "label": "200 OK",
                  "style": "response"
                },
                {
                  "kind": "flow",
                  "start": 3250,
                  "end": 3650,
                  "edge": "e0",
                  "from": "proxy",
                  "to": "in",
                  "reverse": true,
                  "label": "200 OK",
                  "style": "response"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
