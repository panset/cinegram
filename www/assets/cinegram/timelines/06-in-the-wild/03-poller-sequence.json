      "scenarios": [
        {
          "id": "s0",
          "name": "one polling cycle",
          "duration": 12600,
          "speed": 1,
          "loop": false,
          "autoplay": false,
          "steps": [
            {
              "id": "wake",
              "name": "Wake up and remember where you left off",
              "desc": "A poller has no one to tell it that something changed, so it asks on a timer — here every thirty minutes. Before it can ask anything useful it loads its own saved state, because 'what is new' only means something relative to what it saw last time.",
              "start": 0,
              "end": 1800,
              "tracks": [
                {
                  "kind": "focus",
                  "start": 0,
                  "end": 1800,
                  "target": "poller"
                },
                {
                  "kind": "flow",
                  "start": 0,
                  "end": 600,
                  "edge": "e0",
                  "from": "poller",
                  "to": "poller"
                },
                {
                  "kind": "flow",
                  "start": 600,
                  "end": 1200,
                  "edge": "e1",
                  "from": "poller",
                  "to": "pollerState"
                },
                {
                  "kind": "flow",
                  "start": 1200,
                  "end": 1800,
                  "edge": "e2",
                  "from": "pollerState",
                  "to": "poller",
                  "style": "response"
                }
              ]
            },
            {
              "id": "fetch",
              "name": "For each config, fetch the latest from the API",
              "desc": "One poller usually watches many things, so it loops over its configured targets and pulls the current data for each. This is the expensive half of the cycle and the reason polling intervals exist at all: every config here is a round trip to somebody else's API.",
              "start": 1800,
              "end": 3800,
              "tracks": [
                {
                  "kind": "focus",
                  "start": 1800,
                  "end": 3800,
                  "target": "poller"
                },
                {
                  "kind": "flow",
                  "start": 1800,
                  "end": 2400,
                  "edge": "e3",
                  "from": "poller",
                  "to": "poller"
                },
                {
                  "kind": "flow",
                  "start": 2400,
                  "end": 3100,
                  "edge": "e4",
                  "from": "poller",
                  "to": "API"
                },
                {
                  "kind": "flow",
                  "start": 3100,
                  "end": 3800,
                  "edge": "e5",
                  "from": "API",
                  "to": "poller",
                  "style": "response"
                }
              ]
            },
            {
              "id": "store",
              "name": "Diff against the old state and write the new one",
              "desc": "The poller compares what it just fetched with what it loaded in step one, and the difference is the whole product of the cycle. It writes the fresh snapshot back immediately, so a crash later on cannot make it replay work it has already done.",
              "start": 3800,
              "end": 4500,
              "tracks": [
                {
                  "kind": "focus",
                  "start": 3800,
                  "end": 4500,
                  "target": "pollerState"
                },
                {
                  "kind": "flow",
                  "start": 3800,
                  "end": 4500,
                  "edge": "e6",
                  "from": "poller",
                  "to": "pollerState"
                }
              ]
            },
            {
              "id": "dispatch",
              "name": "Turn each change into a webhook-shaped call",
              "desc": "Now the poller stops being a poller. For every change it found it calls the handler exactly the way a real webhook would, which means everything downstream is written once and does not care whether the trigger was a push or a poll.",
              "start": 4500,
              "end": 5300,
              "tracks": [
                {
                  "kind": "focus",
                  "start": 4500,
                  "end": 5300,
                  "target": "handler"
                },
                {
                  "kind": "flow",
                  "start": 4500,
                  "end": 5300,
                  "edge": "e7",
                  "from": "poller",
                  "to": "handler"
                }
              ]
            },
            {
              "id": "enrich",
              "name": "The handler enriches the change from both systems",
              "desc": "A change notification is thin — usually an id and a verb. The handler has to fetch the rest before it can act, and it needs it from two places: the API the poller was watching, and the Service that will own the result.",
              "start": 5300,
              "end": 7500,
              "tracks": [
                {
                  "kind": "focus",
                  "start": 5300,
                  "end": 7500,
                  "target": "handler"
                },
                {
                  "kind": "flow",
                  "start": 5300,
                  "end": 5850,
                  "edge": "e8",
                  "from": "handler",
                  "to": "API"
                },
                {
                  "kind": "flow",
                  "start": 5850,
                  "end": 6400,
                  "edge": "e9",
                  "from": "API",
                  "to": "handler",
                  "style": "response"
                },
                {
                  "kind": "flow",
                  "start": 6400,
                  "end": 6950,
                  "edge": "e10",
                  "from": "handler",
                  "to": "Service"
                },
                {
                  "kind": "flow",
                  "start": 6950,
                  "end": 7500,
                  "edge": "e11",
                  "from": "Service",
                  "to": "handler",
                  "style": "response"
                }
              ]
            },
            {
              "id": "create",
              "name": "Create the user in the Service",
              "desc": "This is the one write in the whole cycle that changes the outside world. Everything before it was reading; everything after it is reacting to the fact that this happened.",
              "start": 7500,
              "end": 8300,
              "tracks": [
                {
                  "kind": "focus",
                  "start": 7500,
                  "end": 8300,
                  "target": "Service"
                },
                {
                  "kind": "flow",
                  "start": 7500,
                  "end": 8300,
                  "edge": "e12",
                  "from": "handler",
                  "to": "Service"
                }
              ]
            },
            {
              "id": "event",
              "name": "The Service changes state and fans an event back out",
              "desc": "The write is not the end of it: creating the user moves the Service through its own state machine, and that transition emits an event of its own. The handler that caused it is now also a listener for it — which is exactly where a fan-out like this starts to get hard to follow on a static diagram.",
              "start": 8300,
              "end": 9600,
              "tracks": [
                {
                  "kind": "focus",
                  "start": 8300,
                  "end": 9600,
                  "target": "Service"
                },
                {
                  "kind": "flow",
                  "start": 8300,
                  "end": 8900,
                  "edge": "e13",
                  "from": "Service",
                  "to": "Service"
                },
                {
                  "kind": "flow",
                  "start": 8900,
                  "end": 9600,
                  "edge": "e14",
                  "from": "Service",
                  "to": "handler"
                }
              ]
            },
            {
              "id": "reenrich",
              "name": "The handler enriches again, for the new event",
              "desc": "The event carries no more detail than the first notification did, so the handler goes back to the Service for the current picture. The repetition is not waste — the state it read in step five is stale now, because step six is what changed it.",
              "start": 9600,
              "end": 10800,
              "tracks": [
                {
                  "kind": "focus",
                  "start": 9600,
                  "end": 10800,
                  "target": "handler"
                },
                {
                  "kind": "flow",
                  "start": 9600,
                  "end": 10200,
                  "edge": "e15",
                  "from": "handler",
                  "to": "Service"
                },
                {
                  "kind": "flow",
                  "start": 10200,
                  "end": 10800,
                  "edge": "e16",
                  "from": "Service",
                  "to": "handler",
                  "style": "response"
                }
              ]
            },
            {
              "id": "update",
              "name": "Write the result back to the API",
              "desc": "The handler reads the API one last time to avoid clobbering anything that moved while it worked, then writes the new state back. The cycle closes: in thirty minutes the poller will read that state as its baseline and the whole page replays.",
              "start": 10800,
              "end": 12600,
              "tracks": [
                {
                  "kind": "focus",
                  "start": 10800,
                  "end": 12600,
                  "target": "API"
                },
                {
                  "kind": "flow",
                  "start": 10800,
                  "end": 11350,
                  "edge": "e17",
                  "from": "handler",
                  "to": "API"
                },
                {
                  "kind": "flow",
                  "start": 11350,
                  "end": 11900,
                  "edge": "e18",
                  "from": "API",
                  "to": "handler",
                  "style": "response"
                },
                {
                  "kind": "flow",
                  "start": 11900,
                  "end": 12600,
                  "edge": "e19",
                  "from": "handler",
                  "to": "API"
                }
              ]
            }
          ],
