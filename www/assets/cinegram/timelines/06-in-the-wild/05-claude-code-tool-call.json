              "label": "allowed",
              "value": "ok"
            },
            {
              "kind": "gauge",
              "start": 4300,
              "end": 6800,
              "target": "cli",
              "label": "turn",
              "value": "2"
            },
            {
              "kind": "set",
              "start": 4300,
              "end": 5500,
              "target": "api",
              "label": "thinking",
              "value": "busy"
            }
          ]
        },
