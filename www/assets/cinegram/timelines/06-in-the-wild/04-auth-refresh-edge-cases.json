                  "kind": "flow",
                  "start": 2550,
                  "end": 3100,
                  "edge": "e4",
                  "from": "Cache",
                  "to": "Auth",
                  "style": "response"
                }
              ]
            },
            {
              "id": "exchange",
              "name": "The auth service swaps the refresh token at the IdP",
              "desc": "The auth service never mints tokens itself; it is a client of the identity provider like everyone else. That indirection is what makes the next scenario possible — and painful.",
              "start": 3100,
              "end": 4500,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 3100,
                  "end": 3800,
                  "edge": "e6",
                  "from": "Auth",
                  "to": "IdP"
                },
                {
                  "kind": "flow",
                  "start": 3800,
                  "end": 4500,
                  "edge": "e7",
                  "from": "IdP",
                  "to": "Auth",
                  "style": "response"
                },
                {
                  "kind": "focus",
                  "start": 3100,
                  "end": 4500,
                  "target": "IdP"
                }
              ]
            },
            {
              "id": "rotate",
              "name": "The refresh token rotates, then the app gets its new pair",
              "desc": "rt_7 is retired the moment rt_8 exists. Rotation is what turns a stolen refresh token from a permanent backdoor into a token that stops working the next time the real client refreshes.",
              "start": 4500,
              "end": 5700,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 4500,
                  "end": 5050,
                  "edge": "e9",
                  "from": "Auth",
                  "to": "Cache"
                },
