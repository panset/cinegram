{
  "version": 2,
  "root": "01-k8s-request",
  "views": [
    {
      "id": "01-k8s-request",
      "title": "GET /api/orders",
      "diagram": {
        "type": "flowchart",
        "direction": "LR",
        "mermaid": "%% API request path through a Kubernetes cluster.\n%% Strip the scenario block and this is ordinary Mermaid.\nflowchart LR\n  client[External Client]\n  lb[(Cloud Load Balancer)]\n  subgraph cluster[Kubernetes Cluster]\n    ing[Ingress Controller]\n    subgraph cp[control plane]\n      api[kube-apiserver]\n      etcd[(etcd)]\n    end\n    subgraph ns[namespace: prod]\n      svc[ClusterIP Service]\n      pod1[Pod A]\n      pod2[Pod B]\n    end\n  end\n  client --\u003e lb\n  lb --\u003e ing\n  ing --\u003e svc\n  svc --\u003e pod1\n  svc --\u003e pod2\n  api --\u003e etcd\n"
      },
      "nodes": [
        {
          "id": "client",
          "label": "External Client",
          "shape": "rect"
        },
        {
          "id": "lb",
          "label": "Cloud Load Balancer",
          "shape": "cylinder"
        },
        {
          "id": "ing",
          "label": "Ingress Controller",
          "shape": "rect",
          "group": "cluster"
        },
        {
          "id": "api",
          "label": "kube-apiserver",
          "shape": "rect",
          "group": "cp"
        },
        {
          "id": "etcd",
          "label": "etcd",
          "shape": "cylinder",
          "group": "cp"
        },
        {
          "id": "svc",
          "label": "ClusterIP Service",
          "shape": "rect",
          "group": "ns"
        },
        {
          "id": "pod1",
          "label": "Pod A",
          "shape": "rect",
          "group": "ns"
        },
        {
          "id": "pod2",
          "label": "Pod B",
          "shape": "rect",
          "group": "ns"
        }
      ],
      "groups": [
        {
          "id": "cluster",
          "label": "Kubernetes Cluster",
          "children": [
            "ing",
            "cp",
            "ns"
          ]
        },
        {
          "id": "cp",
          "label": "control plane",
          "parent": "cluster",
          "children": [
            "api",
            "etcd"
          ]
        },
        {
          "id": "ns",
          "label": "namespace: prod",
          "parent": "cluster",
          "children": [
            "svc",
            "pod1",
            "pod2"
          ]
        }
      ],
      "edges": [
        {
          "id": "e0",
          "from": "client",
          "to": "lb",
          "style": "normal",
          "head": "arrow"
        },
        {
          "id": "e1",
          "from": "lb",
          "to": "ing",
          "style": "normal",
          "head": "arrow"
        },
        {
          "id": "e2",
          "from": "ing",
          "to": "svc",
          "style": "normal",
          "head": "arrow"
        },
        {
          "id": "e3",
          "from": "svc",
          "to": "pod1",
          "style": "normal",
          "head": "arrow"
        },
        {
          "id": "e4",
          "from": "svc",
          "to": "pod2",
          "style": "normal",
          "head": "arrow"
        },
        {
          "id": "e5",
          "from": "api",
          "to": "etcd",
          "style": "normal",
          "head": "arrow"
        }
      ],
      "scenarios": [
        {
          "id": "s0",
          "name": "GET /api/orders",
          "duration": 4700,
          "speed": 1,
          "loop": true,
          "autoplay": false,
          "steps": [
            {
              "id": "edge",
              "name": "Request reaches the load balancer",
              "start": 0,
              "end": 700,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 0,
                  "end": 700,
                  "edge": "e0",
                  "from": "client",
                  "to": "lb",
                  "label": "GET /api/orders"
                },
                {
                  "kind": "highlight",
                  "start": 0,
                  "end": 700,
                  "target": "lb",
                  "style": "active"
                }
              ]
            },
            {
              "id": "terminate",
              "name": "TLS terminates at the ingress controller",
              "start": 700,
              "end": 1300,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 700,
                  "end": 1300,
                  "edge": "e1",
                  "from": "lb",
                  "to": "ing",
                  "label": "HTTP/1.1"
                },
                {
                  "kind": "highlight",
                  "start": 700,
                  "end": 1300,
                  "target": "ing",
                  "style": "active"
                }
              ]
            },
            {
              "id": "route",
              "name": "Ingress rule matches host and path",
              "start": 1300,
              "end": 1800,
              "tracks": [
                {
                  "kind": "note",
                  "start": 1300,
                  "end": 1800,
                  "target": "ing",
                  "text": "host: api.example.com\npath: /api/*"
                },
                {
                  "kind": "flow",
                  "start": 1300,
                  "end": 1800,
                  "edge": "e2",
                  "from": "ing",
                  "to": "svc"
                }
              ]
            },
            {
              "id": "balance",
              "name": "kube-proxy picks a healthy endpoint",
              "start": 1800,
              "end": 2400,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 1800,
                  "end": 2400,
                  "edge": "e3",
                  "from": "svc",
                  "to": "pod1",
                  "label": "10.1.2.3:8080"
                },
                {
                  "kind": "dim",
                  "start": 1800,
                  "end": 2400,
                  "target": "pod2"
                }
              ]
            },
            {
              "id": "work",
              "name": "Pod A handles the request",
              "start": 2400,
              "end": 3300,
              "tracks": [
                {
                  "kind": "highlight",
                  "start": 2400,
                  "end": 3300,
                  "target": "pod1",
                  "style": "busy"
                },
                {
                  "kind": "note",
                  "start": 2400,
                  "end": 3300,
                  "target": "pod1",
                  "text": "200 OK in 14ms"
                }
              ]
            },
            {
              "id": "respond",
              "name": "Response travels back to the client",
              "start": 3300,
              "end": 4700,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 3300,
                  "end": 3650,
                  "edge": "e3",
                  "from": "pod1",
                  "to": "svc",
                  "reverse": true,
                  "label": "200 OK",
                  "style": "response"
                },
                {
                  "kind": "flow",
                  "start": 3650,
                  "end": 4000,
                  "edge": "e2",
                  "from": "svc",
                  "to": "ing",
                  "reverse": true,
                  "label": "200 OK",
                  "style": "response"
                },
                {
                  "kind": "flow",
                  "start": 4000,
                  "end": 4350,
                  "edge": "e1",
                  "from": "ing",
                  "to": "lb",
                  "reverse": true,
                  "label": "200 OK",
                  "style": "response"
                },
                {
                  "kind": "flow",
                  "start": 4350,
                  "end": 4700,
                  "edge": "e0",
                  "from": "lb",
                  "to": "client",
                  "reverse": true,
                  "label": "200 OK",
                  "style": "response"
                }
              ]
            }
          ]
        }
      ],
      "bindings": [
        {
          "source": "pod1",
          "kind": "view",
          "view": "pod-a",
          "label": "Zoom into Pod A"
        },
        {
          "source": "cluster",
          "kind": "reveal",
          "targets": [
            "cp",
            "api",
            "etcd"
          ]
        },
        {
          "source": "pod2",
          "kind": "step",
          "step": "balance"
        }
      ],
      "hidden": [
        "cp",
        "api",
        "etcd"
      ]
    },
    {
      "id": "pod-a",
      "title": "Inside Pod A",
      "diagram": {
        "type": "flowchart",
        "direction": "LR",
        "mermaid": "%% What Pod A does with a request once kube-proxy has picked it.\n%% Reached by clicking Pod A in 01-basics/01-k8s-request.dgm — and by clicking\n%% the server in 04-diagram-types/01-websocket-handshake.dgm, which is why this\n%% file sits at the root rather than inside either folder. Previewable alone.\nflowchart LR\n  in[Request from Service]\n  subgraph pod[Pod A]\n    proxy[Envoy Sidecar]\n    app[Order API Container]\n    cache[(Local Cache)]\n  end\n  db[(Orders Postgres)]\n  in --\u003e proxy\n  proxy --\u003e app\n  app --\u003e cache\n  app --\u003e db\n"
      },
      "nodes": [
        {
          "id": "in",
          "label": "Request from Service",
          "shape": "rect"
        },
        {
          "id": "proxy",
          "label": "Envoy Sidecar",
          "shape": "rect",
          "group": "pod"
        },
        {
          "id": "app",
          "label": "Order API Container",
          "shape": "rect",
          "group": "pod"
        },
        {
          "id": "cache",
          "label": "Local Cache",
          "shape": "cylinder",
          "group": "pod"
        },
        {
          "id": "db",
          "label": "Orders Postgres",
          "shape": "cylinder"
        }
      ],
      "groups": [
        {
          "id": "pod",
          "label": "Pod A",
          "children": [
            "proxy",
            "app",
            "cache"
          ]
        }
      ],
      "edges": [
        {
          "id": "e0",
          "from": "in",
          "to": "proxy",
          "style": "normal",
          "head": "arrow"
        },
        {
          "id": "e1",
          "from": "proxy",
          "to": "app",
          "style": "normal",
          "head": "arrow"
        },
        {
          "id": "e2",
          "from": "app",
          "to": "cache",
          "style": "normal",
          "head": "arrow"
        },
        {
          "id": "e3",
          "from": "app",
          "to": "db",
          "style": "normal",
          "head": "arrow"
        }
      ],
      "scenarios": [
        {
          "id": "s0",
          "name": "fetch orders",
          "duration": 3650,
          "speed": 1,
          "loop": true,
          "autoplay": false,
          "steps": [
            {
              "id": "admit",
              "name": "Sidecar admits the request",
              "start": 0,
              "end": 500,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 0,
                  "end": 500,
                  "edge": "e0",
                  "from": "in",
                  "to": "proxy",
                  "label": "GET /api/orders"
                },
                {
                  "kind": "highlight",
                  "start": 0,
                  "end": 500,
                  "target": "proxy",
                  "style": "active"
                }
              ]
            },
            {
              "id": "forward",
              "name": "Proxy forwards to the app container",
              "start": 500,
              "end": 900,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 500,
                  "end": 900,
                  "edge": "e1",
                  "from": "proxy",
                  "to": "app",
                  "label": "localhost:8080"
                },
                {
                  "kind": "note",
                  "start": 500,
                  "end": 900,
                  "target": "proxy",
                  "text": "mTLS terminated\nrate limit ok"
                }
              ]
            },
            {
              "id": "lookup",
              "name": "App checks its local cache first",
              "start": 900,
              "end": 1250,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 900,
                  "end": 1250,
                  "edge": "e2",
                  "from": "app",
                  "to": "cache",
                  "label": "orders:u42"
                },
                {
                  "kind": "note",
                  "start": 900,
                  "end": 1250,
                  "target": "cache",
                  "text": "miss"
                }
              ]
            },
            {
              "id": "query",
              "name": "Cache miss, so the app queries Postgres",
              "start": 1250,
              "end": 1950,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 1250,
                  "end": 1950,
                  "edge": "e3",
                  "from": "app",
                  "to": "db",
                  "label": "SELECT * FROM orders"
                },
                {
                  "kind": "highlight",
                  "start": 1250,
                  "end": 1950,
                  "target": "db",
                  "style": "busy"
                }
              ]
            },
            {
              "id": "rows",
              "name": "Postgres returns the rows",
              "start": 1950,
              "end": 2550,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 1950,
                  "end": 2550,
                  "edge": "e3",
                  "from": "db",
                  "to": "app",
                  "reverse": true,
                  "label": "14 rows",
                  "style": "response"
                },
                {
                  "kind": "highlight",
                  "start": 1950,
                  "end": 2450,
                  "target": "app",
                  "style": "busy"
                }
              ]
            },
            {
              "id": "fill",
              "name": "App fills the cache and answers",
              "start": 2550,
              "end": 2850,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 2550,
                  "end": 2850,
                  "edge": "e2",
                  "from": "app",
                  "to": "cache",
                  "label": "SET orders:u42"
                },
                {
                  "kind": "note",
                  "start": 2550,
                  "end": 2850,
                  "target": "app",
                  "text": "200 OK in 14ms"
                }
              ]
            },
            {
              "id": "reply",
              "name": "Response leaves the pod",
              "start": 2850,
              "end": 3650,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 2850,
                  "end": 3250,
                  "edge": "e1",
                  "from": "app",
                  "to": "proxy",
                  "reverse": true,
                  "label": "200 OK",
                  "style": "response"
                },
                {
                  "kind": "flow",
                  "start": 3250,
                  "end": 3650,
                  "edge": "e0",
                  "from": "proxy",
                  "to": "in",
                  "reverse": true,
                  "label": "200 OK",
                  "style": "response"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
