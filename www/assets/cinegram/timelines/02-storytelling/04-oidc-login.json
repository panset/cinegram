                  "start": 16000,
                  "end": 16000,
                  "target": "app_home"
                },
                {
                  "kind": "highlight",
                  "start": 14900,
                  "end": 17000,
                  "target": "U",
                  "color": "#16a34a"
                }
              ]
            }
          ],
