load("@rules_go//go:def.bzl", "go_test")

# The extension's copies of the browser assets. They are committed, because the
# extension has to work when installed from this folder on a machine with no
# Bazel and no Go.
filegroup(
    name = "media",
    srcs = glob(["media/*"]),
    visibility = ["//visibility:public"],
)

# gazelle:ignore
go_test(
    name = "assets_test",
    srcs = [
        "assets_test.go",
        "version_test.go",
    ],
    data = [
        "CHANGELOG.md",
        "LICENSE.txt",
        "package.json",
        ":media",
        "//:LICENSE",
        "//cmd/cinegram:version.go",
        "//packaging:npm/package.json",
        "//packaging:pypi/pyproject.toml",
        "//pkg/emit/html:browser_assets",
    ],
    deps = ["//internal/repotest"],
)

# The fix for what assets_test reports. Aliased here so that the command the
# failure message prints lives beside the check that prints it.
alias(
    name = "sync_assets",
    actual = "//editors/vscode/sync",
)
