{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "markdown.dgm.codeblock",
  "comment": "Colours a ```dgm fence inside a Markdown document. Injected rather than standalone, because the block belongs to the Markdown grammar's fenced-code rule and only borrows ours for its contents.",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    { "include": "#dgm-code-block" }
  ],
  "repository": {
    "dgm-code-block": {
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(dgm|cinegram))\\b[^`]*$",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" }
      },
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "endCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.dgm",
          "patterns": [{ "include": "source.dgm" }]
        }
      ]
    }
  }
}
