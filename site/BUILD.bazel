load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "site",
    srcs = ["site.go"],
    importpath = "github.com/tejaspanse/cinegram/site",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/compile",
        "//pkg/emit/html",
        "//pkg/loader",
    ],
)

go_test(
    name = "site_test",
    size = "small",
    srcs = [
        "freshness_test.go",
        "site_test.go",
    ],
    # The freshness test regenerates the site from the examples and diffs the
    # result against the committed docs/ tree.
    data = [
        "//:docs",
        "//:examples",
    ],
    embed = [":site"],
    deps = ["//internal/repotest"],
)

# The fix for what the freshness test reports. Aliased here so that the
# command the failure message prints lives beside the check that prints it.
alias(
    name = "sync",
    actual = "//site/sync",
)
