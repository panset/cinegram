load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "site",
    srcs = [
        "guide.go",
        "site.go",
    ],
    importpath = "github.com/tejaspanse/cinegram/site",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/ir",
        "//pkg/sitegen",
    ],
)

go_test(
    name = "site_test",
    size = "small",
    srcs = [
        "config_test.go",
        "freshness_test.go",
        "site_test.go",
    ],
    # The freshness test regenerates the pages from the examples and the
    # README and diffs the result against the committed www/ tree.
    data = [
        "//:examples",
        "//:readme",
        "//:www",
        "//:zensical_config",
    ],
    embed = [":site"],
    deps = [
        "//internal/repotest",
        "//pkg/embedkit",
    ],
)

# The fix for what the freshness test reports. Aliased here so that the
# command the failure message prints lives beside the check that prints it.
alias(
    name = "sync",
    actual = "//site/sync",
)
