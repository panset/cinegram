load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "site",
    srcs = [
        "guide.go",
        "site.go",
    ],
    importpath = "github.com/tejaspanse/cinegram/site",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/ir",
        "//pkg/sitegen",
    ],
)

go_test(
    name = "site_test",
    size = "small",
    srcs = [
        "config_test.go",
        "freshness_test.go",
        "palette_test.go",
        "site_test.go",
    ],
    # The freshness test regenerates the pages from the examples and the
    # README and diffs the result against the committed www/ tree; the palette
    # test reads mainframe.css out of the same tree, and the playground's
    # hand-written index.html, which is the one page that spells the skin's name
    # out instead of taking it from html.Skin. runtime.css needs no data entry —
    # the palette test takes it from the emitter's own embed.
    data = [
        "//:examples",
        "//:readme",
        "//:www",
        "//:zensical_config",
        "//web/playground:static",
    ],
    embed = [":site"],
    deps = [
        "//internal/repotest",
        "//pkg/embedkit",
        "//pkg/emit/html",
    ],
)

# The fix for what the freshness test reports. Aliased here so that the
# command the failure message prints lives beside the check that prints it.
alias(
    name = "sync",
    actual = "//site/sync",
)
