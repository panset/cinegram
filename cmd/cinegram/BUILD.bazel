load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "cinegram_lib",
    srcs = [
        "capture.go",
        "main.go",
        "record.go",
        "serve.go",
    ],
    importpath = "github.com/tejaspanse/cinegram/cmd/cinegram",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/compile",
        "//pkg/diag",
        "//pkg/emit/html",
        "//pkg/emit/mermaid",
        "//pkg/emit/narrate",
        "//pkg/gifenc",
        "//pkg/ir",
        "//pkg/loader",
        "//pkg/parser",
        "//pkg/units",
    ],
)

go_binary(
    name = "cinegram",
    embed = [":cinegram_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "cinegram_test",
    srcs = [
        "main_test.go",
        "record_test.go",
        "serve_test.go",
    ],
    embed = [":cinegram_lib"],
    deps = [
        "//pkg/diag",
        "//pkg/source",
    ],
)
