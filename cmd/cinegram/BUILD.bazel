load("@rules_go//go:def.bzl", "go_binary", "go_cross_binary", "go_library", "go_test")

# This file is hand-maintained: the `# gazelle:ignore` guarding the
# go_cross_binary list below is file-scoped, not block-scoped, so gazelle
# skips the whole file. A new .go source here has to be added to srcs by hand
# — `bazel run //:gazelle` will not do it, and will not say so either.

# The version constant, read by //editors/vscode:assets_test to check it
# agrees with the extension manifest and changelog.
exports_files(["version.go"])

go_library(
    name = "cinegram_lib",
    srcs = [
        "assets.go",
        "capture.go",
        "main.go",
        "record.go",
        "serve.go",
        "site.go",
        "upgrade.go",
        "version.go",
    ],
    importpath = "github.com/tejaspanse/cinegram/cmd/cinegram",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/compile",
        "//pkg/diag",
        "//pkg/embedkit",
        "//pkg/emit/html",
        "//pkg/emit/mermaid",
        "//pkg/emit/narrate",
        "//pkg/envelope",
        "//pkg/gifenc",
        "//pkg/ir",
        "//pkg/loader",
        "//pkg/parser",
        "//pkg/sitegen",
        "//pkg/units",
    ],
)

go_binary(
    name = "cinegram",
    embed = [":cinegram_lib"],
    visibility = ["//visibility:public"],
)

# One binary per platform the VS Code extension ships for.
#
# The extension spawns this rather than reimplementing anything, so a package
# for a platform is a package with the matching binary in it — which means
# building all of them from one machine. The hermetic Go SDK makes that a flag
# rather than a cross-compilation toolchain to install.
#
# gazelle:ignore
[
    go_cross_binary(
        name = "cinegram_" + target,
        platform = "@rules_go//go/toolchain:" + platform,
        target = ":cinegram",
        visibility = ["//visibility:public"],
    )
    for target, platform in {
        "darwin-arm64": "darwin_arm64",
        "darwin-x64": "darwin_amd64",
        "linux-arm64": "linux_arm64",
        "linux-x64": "linux_amd64",
        "win32-x64": "windows_amd64",
    }.items()
]

go_test(
    name = "cinegram_test",
    srcs = [
        "assets_test.go",
        "main_test.go",
        "record_test.go",
        "serve_test.go",
        "upgrade_test.go",
    ],
    embed = [":cinegram_lib"],
    deps = [
        "//pkg/diag",
        "//pkg/embedkit",
        "//pkg/envelope",
        "//pkg/source",
    ],
)
