diagram: flowchart (flowchart SIDEWAYS)
direction: TB

nodes:
  client     label="Client"                 shape=rect      
  ing        label="Ingress"                shape=rect      
  svc        label="Service"                shape=rect      

edges:
  e0   client -> ing style=normal head=arrow

views:
  real       title="Fine"               from="other.dgm"
  dupe       title=""                   from="/etc/passwd"
  dupe       title=""                   from="again.dgm"
  orphan     title=""                   from="nobody-clicks-me.dgm"

interact:
  click client     -> view real
  click client     -> reveal svc
  click nosuchnode -> reveal svc
  click ing        -> view missing
  click svc        -> reveal notanode
  click ing        -> step nosuchstep
  click ing        -> reveal ing
  click ing        -> view real {wobble="3"}
  click svc        -> url javascript:alert(1)
  click svc        -> url 

scenario "broken"
  step a "unknown node"
    highlight ingres
  step b "no edge to travel along"
    flow client -> svc
  step c "bad duration and unknown attribute"
    highlight ing {dur="soon" wobble="3"}
  step d "unknown action"
  step e "misspelt attributes"
    flow client -> ing {colour="red" durr="300ms"}
  step f "attribute that belongs to another action"
    highlight ing {ease="in-out"}
  step g "unknown easing"
    flow client -> ing {ease="bouncy"}
  step h "unknown status"
    flow client -> ing {status="maybe"}
  step i "status on an action that has no outcome"
    highlight ing {status="fail"}
  step j "gauge missing both of the things that identify it"
    gauge ing
  step k "a persistent action cannot expire"
    set ing {badge="leader" dur="500ms"}
  step a "duplicate step id"
    highlight ing

