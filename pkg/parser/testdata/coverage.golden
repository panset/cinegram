diagram: flowchart (flowchart LR)
direction: LR

nodes:
  a          label="Entry"                  shape=rect      
  b          label="Middle"                 shape=rect      
  orphan     label="Declared And Then Forgotten" shape=rect      
  inner      label="Also Unmentioned"       shape=rect       group=aside

groups:
  aside      label="Grouping Nobody Uses"   parent=-          children=[inner]

edges:
  e0   a -> b style=normal head=arrow

interact:
  click a          -> step later

scenario "same name"
  step first "in the first scenario"
    flow a -> b

scenario "same name"
  step later "only in the second scenario"
    highlight b

diagnostics:
  5:1: warning: an empty `%%` comment breaks Mermaid's comment stripping and the diagram will not render
    hint: write `%% -` or delete the line
  9:3: warning: "orphan" is declared but nothing references it
    hint: is orphan supposed to be animated, or connected to something?
  11:3: warning: subgraph "aside" is declared but nothing references it or anything inside it
    hint: is aside supposed to be animated, or to hold something?
  12:5: warning: "inner" is declared but nothing references it
    hint: is inner supposed to be animated, or connected to something?
  19:19: warning: step "later" is only in scenario "same name", so this click does nothing until that scenario is chosen
    hint: a step click acts on the scenario currently selected; give scenario same name a step of this name too, or bind to a step in the first scenario
  28:1: warning: duplicate scenario name "same name"
    hint: give each scenario a distinct name; the picker shows nothing else
