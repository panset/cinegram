diagram: flowchart (flowchart LR)
direction: LR

nodes:
  client     label="Client"                 shape=rect      
  ing        label="Ingress"                shape=rect      
  svc        label="Service"                shape=rect      
  db         label="Database"               shape=cylinder  

edges:
  e0   client -> ing style=normal head=arrow
  e1   ing -> svc style=normal head=arrow
  e2   svc -> db style=normal head=arrow

views:
  detail     title="Detail"             from="pod-a.dgm"

storyboard "Frames"
  frame opening      img=""                           caption="the only frame there is"

interact:
  click clint      -> reveal svc
  click ing        -> view detial
  click svc        -> reveal ingres
  click db         -> step twoo

scenario "base"
  step one "the shared opening"
    flow client -> ing
  step two "and on to the service"
    flow ing -> svc {colour="teal"}

scenario "misspelt targets"
  step three "a node and a frame, both nearly right"
    highlight ingres
    scene openning

scenario "inherits from a name that is nearly right" {variant="bse"}
  step four "nothing to inherit"
    flow svc -> db

scenario "inherits up to a step that is nearly right" {variant="base" until="tow"}
  step five "no such step in the base"
    flow svc -> db

diagnostics:
