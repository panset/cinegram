diagram: flowchart (flowchart LR)
direction: LR

nodes:
  a          label="A"                      shape=rect      
  b          label="B"                      shape=rect      

edges:
  e0   a -> b style=normal head=arrow

scenario "base" {speed="1.0"}
  step one "First" {desc="The engineer's words."}
    flow a -> b {dur="500ms"}

scenario "missing base" {retells="nope"}
  step one "one" {desc="x"}

scenario "self" {retells="self"}
  step one "one" {desc="x"}

scenario "carries actions" {retells="base"}
  step one "one" {desc="x"}
    flow a -> b {dur="200ms"}

scenario "unknown step" {retells="base"}
  step two "two" {desc="x"}

scenario "anonymous step" {retells="base"}
  step - "" {desc="x"}

scenario "variant as well" {retells="base" variant="base"}
  step one "one" {desc="x"}

scenario "retells a retelling" {retells="missing base"}
  step one "one" {desc="x"}

scenario "overrides nothing" {retells="base"}
  step one "one"

scenario "overrides no step at all" {retells="base"}

