              "end": 1800,
              "tracks": [
                {
                  "kind": "flow",
                  "start": 1500,
                  "end": 1800,
                  "edge": "e0",
                  "from": "a",
                  "to": "b"
                }
              ]
            }
          ],
          "persistent": [
            {
              "kind": "set",
              "start": 0,
              "end": 1500,
              "target": "b",
              "label": "accepted",
              "value": "ok"
            },
            {
              "kind": "set",
              "start": 1500,
              "end": 1800,
              "target": "b",
