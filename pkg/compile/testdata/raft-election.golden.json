              ]
            },
            {
              "id": "timeout",
              "name": "n3's election timer fires first",
              "desc": "Election timeouts are randomised precisely so that one node usually reaches zero first. n3 increments the term, votes for itself, and asks the others to agree.",
              "start": 1100,
              "end": 1600,
              "tracks": [
                {
                  "kind": "dim",
                  "start": 1100,
                  "end": 1600,
                  "target": "n1"
