              ]
            },
            {
              "id": "votes",
              "name": "A majority answers",
              "desc": "Each follower grants at most one vote per term, so two candidates in the same term cannot both win. Three of five is a majority and that is enough.",
              "start": 1600,
              "end": 2050,
              "tracks": [
                {
                  "kind": "dim",
