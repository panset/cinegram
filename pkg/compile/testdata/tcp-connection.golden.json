                {
                  "kind": "dim",
                  "start": 4300,
                  "end": 5100,
                  "target": "Teardown"
                }
              ]
            },
            {
              "id": "done",
              "name": "Back where it started",
              "desc": "A clean close returns the machine to the same nothing it began as. The end marker is the start marker's twin, and both are ordinary animation targets.",
