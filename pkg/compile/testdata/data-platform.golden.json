      "scenarios": [
        {
          "id": "s0",
          "name": "a row's journey",
          "duration": 10300,
          "speed": 1,
          "loop": false,
          "autoplay": false,
          "steps": [
            {
              "id": "change",
              "name": "A row changes in the application database",
              "desc": "Change data capture reads the write-ahead log rather than polling the table, so the platform learns about the change without the application knowing the platform exists.",
              "start": 0,
              "end": 700,
              "tracks": [
                {
                  "kind": "focus",
                  "start": 0,
                  "end": 700,
                  "target": "sources"
                },
                {
                  "kind": "flow",
                  "start": 0,
                  "end": 700,
                  "edge": "e0",
                  "from": "app",
                  "to": "cdc",
                  "label": "UPDATE orders"
                }
              ]
            },
            {
              "id": "publish",
              "name": "The change is published to the log",
              "desc": "From here it is an immutable event with a schema. Everything downstream is a consumer, and none of them can slow the producer down.",
              "start": 700,
              "end": 1300,
              "tracks": [
                {
                  "kind": "focus",
                  "start": 700,
                  "end": 1300,
                  "target": "bus"
                },
                {
                  "kind": "flow",
                  "start": 700,
                  "end": 1300,
                  "edge": "e4",
                  "from": "cdc",
                  "to": "kafka",
                  "label": "orders.v2"
                }
              ]
            },
            {
              "id": "process",
              "name": "Stream processing cleans it up",
              "desc": "Deduplication first, because at-least-once delivery means the same event will arrive twice and every later stage would otherwise have to cope with it.",
              "start": 1300,
              "end": 2800,
              "tracks": [
                {
                  "kind": "focus",
                  "start": 1300,
                  "end": 2800,
                  "target": "stream"
                },
                {
                  "kind": "flow",
                  "start": 1300,
                  "end": 1800,
                  "edge": "e9",
                  "from": "kafka",
                  "to": "flink",
                  "label": "one event"
                },
                {
                  "kind": "flow",
                  "start": 1800,
                  "end": 2300,
                  "edge": "e10",
                  "from": "flink",
                  "to": "dedupe",
                  "label": "one event"
                },
                {
                  "kind": "flow",
                  "start": 2300,
                  "end": 2800,
                  "edge": "e11",
                  "from": "dedupe",
                  "to": "enrich",
                  "label": "one event"
                }
              ]
            },
            {
              "id": "land",
              "name": "It lands in the lake as bronze",
              "desc": "Bronze is the raw truth: whatever arrived, exactly as it arrived. Nothing is ever corrected here, only downstream, so a bad transformation can always be replayed.",
              "start": 2800,
              "end": 3400,
              "tracks": [
                {
                  "kind": "focus",
                  "start": 2800,
                  "end": 3400,
                  "target": "lake"
                },
                {
                  "kind": "flow",
                  "start": 2800,
                  "end": 3400,
                  "edge": "e12",
                  "from": "enrich",
                  "to": "bronze",
                  "label": "append"
                }
              ]
            },
            {
              "id": "refine",
              "name": "Quality checks promote it to silver",
              "desc": "This is the first stage that can reject a row. A check that fails here stops the promotion rather than propagating a quiet error into everything built on top.",
              "start": 3400,
              "end": 4000,
              "tracks": [
                {
                  "kind": "focus",
                  "start": 3400,
                  "end": 4000,
                  "target": "lake"
                },
                {
                  "kind": "focus",
                  "start": 3400,
                  "end": 4000,
                  "target": "quality"
                },
                {
                  "kind": "flow",
                  "start": 3400,
                  "end": 4000,
                  "edge": "e22",
                  "from": "quality",
                  "to": "silver",
                  "label": "assertions pass"
                },
                {
                  "kind": "flow",
                  "start": 3400,
                  "end": 4000,
                  "edge": "e13",
                  "from": "bronze",
                  "to": "silver",
                  "label": "promote"
                }
              ]
            },
            {
              "id": "model",
              "name": "Gold is the modelled, business-facing shape",
              "desc": "Gold is where table names stop describing systems and start describing the business. Two teams reading the same gold table should mean the same thing by it.",
              "start": 4000,
              "end": 4700,
              "tracks": [
                {
                  "kind": "focus",
                  "start": 4000,
                  "end": 4700,
                  "target": "lake"
                },
                {
                  "kind": "flow",
                  "start": 4000,
                  "end": 4700,
                  "edge": "e14",
                  "from": "silver",
                  "to": "gold",
                  "label": "dbt model"
                }
              ]
            },
            {
              "id": "warehouse-load",
              "name": "The warehouse takes a copy",
              "desc": "The lake keeps history and the warehouse serves queries. Copying rather than querying the lake directly is the trade the platform makes for predictable latency.",
              "start": 4700,
              "end": 6100,
              "tracks": [
                {
                  "kind": "focus",
                  "start": 4700,
                  "end": 6100,
                  "target": "warehouse"
                },
                {
                  "kind": "flow",
                  "start": 4700,
                  "end": 5166,
                  "edge": "e15",
                  "from": "gold",
                  "to": "dw",
                  "label": "load"
                },
                {
                  "kind": "flow",
                  "start": 5166,
                  "end": 5633,
                  "edge": "e16",
                  "from": "dw",
                  "to": "marts",
                  "label": "load"
                },
                {
                  "kind": "flow",
                  "start": 5633,
                  "end": 6100,
                  "edge": "e17",
                  "from": "marts",
                  "to": "semantic",
                  "label": "load"
                }
              ]
            },
            {
              "id": "consume",
              "name": "Three very different consumers",
              "desc": "The same gold table feeds a dashboard, a sync back into the CRM, and a model's features. Sharing that one definition is most of what a data platform is for.",
              "start": 6100,
              "end": 6700,
              "tracks": [
                {
                  "kind": "focus",
                  "start": 6100,
                  "end": 6700,
                  "target": "serve"
                },
                {
                  "kind": "flow",
                  "start": 6100,
                  "end": 6700,
                  "edge": "e18",
                  "from": "semantic",
                  "to": "bi",
                  "label": "query"
                },
                {
                  "kind": "flow",
                  "start": 6100,
                  "end": 6700,
                  "edge": "e19",
                  "from": "gold",
                  "to": "reverse",
                  "label": "sync"
                },
                {
                  "kind": "flow",
                  "start": 6100,
                  "end": 6700,
                  "edge": "e20",
                  "from": "gold",
                  "to": "ml",
                  "label": "features"
                }
              ]
            },
            {
              "id": "whole",
              "name": "The whole platform at once",
              "desc": "Zoom out. Every arrow on this diagram exists because one of the eight steps above needed it, which is the only honest way to draw a picture this size.",
              "start": 6700,
              "end": 10300,
              "tracks": [
                {
