%% Where the OIDC code runs, in two products that share it.
%% ---
%% The interesting claim in this picture is the dotted line. `clusterlib/oidc`
%% is imported, not called: in SSP it runs inside two different pods and in the
%% appliance it runs inside a single binary, and in all three cases the hop into
%% it is a function call. That is why the two products can differ in everything
%% around it — three processes or one, Postgres or SQLite — and still agree on
%% exactly what a valid login is.
%% ---
%% Three scenarios trace the same engine along three different paths. The pods
%% are doors: click one to watch what happens inside it.
graph TD
  subgraph SSP["SSP (Kubernetes)"]
    AuthenaP["authena pod<br/>login / callback / logout / providers"]
    CapiP["cluster-api pod<br/>provider CRUD + validate"]
    PG[("PostgreSQL<br/>oidc_* tables")]
    AuthenaP --> PG
    CapiP --> PG
  end
  subgraph SSPI["SSPI (appliance)"]
    SspiBin["authserver-sspi<br/>login + callback + logout + CRUD (one process)"]
    SQLite[("SQLite<br/>oidc_* tables")]
    SspiBin --> SQLite
  end
  AuthenaP -. imports .-> Engine["clusterlib/oidc<br/>(shared engine: Config, Session, Verify, Flow services + store)"]
  CapiP -. imports .-> Engine
  SspiBin -. imports .-> Engine
  Engine -->|discovery, JWKS, token exchange,<br/>refresh, userinfo| IdP["External OIDC IdP<br/>(AuthHub, VIDB, Okta, Entra, Keycloak…)"]
  Browser["User Browser"] -->|Login with IdP| AuthenaP
  Browser --> SspiBin
  Browser -->|authenticate + MFA| IdP

view login  "A login through authena"     from "oidc-login.dgm"
view verify "Testing a provider"          from "oidc-verify.dgm"

interact {
  %% Each pod is a door into the sequence diagram of what it actually does.
  click AuthenaP -> view login  { label: "Watch a login, message by message" }
  click CapiP    -> view verify { label: "Watch an admin test a provider" }
}

scenario "a login in the cluster" { speed: 1.0 }

  step ssp-arrive "The browser lands on the authena pod" {
    desc: "Two pods, one database, and only one of them is on the login path. The split exists because provider administration and provider use have different traffic, different failure modes and different blast radii — but they must never disagree about what the configuration means."
    focus SSP, Browser
    flow Browser -> AuthenaP { dur: 800ms }
    highlight AuthenaP { style: active }
  }

  step ssp-call "The hop into the engine is not a network hop" {
    desc: "The dotted line is an import. There is no service to be unavailable, no timeout to tune and no version skew between the caller and the engine — the pod ships with the engine it was built against, which is the whole reason this arrow is drawn differently from the others."
    focus SSP, Engine
    flow AuthenaP -> Engine { dur: 700ms }
    highlight Engine { style: busy }
    note Engine "linked in, not called over the wire"
  }

  step ssp-state "The pending login is written to Postgres" {
    desc: "State, nonce and PKCE verifier, under a ten-minute TTL. It goes to shared storage rather than pod memory because the callback is a fresh request that may well land on a different replica, and a login that only works when the load balancer is lucky is not a working login."
    focus SSP
    flow AuthenaP -> PG { dur: 600ms }
    gauge PG { label: "oidc_state", value: "10-min TTL" }
  }

  step ssp-idp "The engine, and only the engine, talks to the IdP" {
    desc: "Discovery, JWKS, token exchange, refresh and userinfo all leave from one place. Adding a provider quirk — an auth method, an extra token parameter — is a change here, and both products get it at once."
    focus Engine, IdP
    flow Engine -> IdP { dur: 900ms }
    highlight IdP { style: active }
  }

  step ssp-mfa "The user authenticates directly with the provider" {
    desc: "This arrow bypasses the cluster entirely. No password and no second factor ever reaches SSP, which is why a compromise of these pods cannot become a compromise of the directory behind them."
    focus Browser, IdP
    flow Browser -> IdP { dur: 900ms }
    note IdP "credentials + MFA\nnever touch SSP" { side: right }
  }

  step ssp-session "Tokens come back, verified, and become a session" {
    desc: "The engine verifies the id_token and hands back a result; the pod writes the session and sets a cookie. The reversed arrows are the same edges run backwards — the picture draws dependencies, and a response travels a dependency in the other direction."
    focus SSP, Engine, IdP
    seq {
      flow IdP -> Engine { dur: 700ms, style: response }
      flow Engine -> AuthenaP { dur: 500ms, style: response }
      flow AuthenaP -> PG { dur: 500ms }
    }
    set PG { badge: "session stored", state: ok, color: "#16a34a" }
  }

scenario "the same engine inside the appliance" { speed: 1.0 }

  step sspi-arrive "One binary answers instead of a pod" {
    desc: "SSPI is an appliance: a single process serving login, callback, logout and provider CRUD together. Everything the cluster does across two pods and a network, this does across two function calls."
    focus SSPI, Browser
    flow Browser -> SspiBin { dur: 800ms }
    highlight SspiBin { style: active }
  }

  step sspi-engine "It imports the identical package" {
    desc: "Not a port, not a reimplementation, not a copy that drifted. The verification rules that decide whether a token is acceptable are the same source file in both products, so a provider that works in one works in the other for reasons stronger than testing."
    focus SSPI, Engine
    flow SspiBin -> Engine { dur: 700ms }
    highlight Engine { style: busy }
  }

  step sspi-store "The store is SQLite, and the engine does not care" {
    desc: "The same `oidc_*` tables against a local file. The store is an interface the engine was given, which is the seam that lets a clustered deployment and a single appliance share everything above it."
    focus SSPI
    flow SspiBin -> SQLite { dur: 600ms }
    gauge SQLite { label: "oidc_*", value: "same schema" }
  }

  step sspi-idp "And the same conversation with the provider" {
    desc: "From the IdP's side these two deployments are indistinguishable: same discovery, same JWKS fetch, same token exchange. That is what makes 'it works in SSP' evidence about SSPI rather than a coincidence."
    focus SSPI, Engine, IdP
    seq {
      flow Engine -> IdP { dur: 800ms }
      flow IdP -> Engine { dur: 700ms, style: response }
    }
    set SspiBin { badge: "logged in", state: ok, color: "#16a34a" }
  }

scenario "an admin configures a provider" { speed: 1.0 }

  step cfg-edit "Administration lives on the other pod" {
    desc: "cluster-api owns provider CRUD, and it reaches the same rows through the same engine. Validation is not a second implementation of the rules — it is the rules, invoked before the row is trusted rather than during someone's login."
    focus SSP, Engine
    flow CapiP -> Engine { dur: 700ms }
    highlight CapiP { style: active }
  }

  step cfg-check "Validation asks the IdP, not a schema" {
    desc: "A well-formed provider row can still be wrong: an issuer that does not serve discovery, a JWKS URL behind a proxy, a client the IdP has never heard of. The only check worth running is the one that talks to the provider."
    focus Engine, IdP
    flow Engine -> IdP { dur: 900ms }
    gauge Engine { label: "validate", value: "discovery + JWKS" }
  }

  step cfg-save "The row is written, encrypted, and immediately live" {
    desc: "The client secret is encrypted at rest, and because the login path rebuilds its client from this row on every request, there is nothing to invalidate and nothing to restart. Click the cluster-api pod to watch an admin prove it with a real login."
    focus SSP
    flow CapiP -> PG { dur: 600ms }
    set PG { badge: "provider saved", state: ok, color: "#16a34a" }
    note CapiP "the next login reads this row —\nno cache to bust" { side: below }
  }
