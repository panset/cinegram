%% "Test connection" for an OIDC provider, done as a real login.
%% ---
%% An admin configuring a provider wants one question answered: will this
%% actually work? Anything short of a real login against the real IdP — a
%% discovery fetch, a reachability check — answers a different, easier question.
%% ---
%% So this flow performs a genuine login and then throws away the only thing a
%% login is normally for. Everything below is the plumbing that costs: a popup
%% opened before there is anything to put in it, a ticket that leaves the
%% admin's session, and a result that has to travel back between two browsing
%% contexts that cannot speak to each other.
sequenceDiagram
  participant UI as Settings page
  participant Popup as Test popup
  participant BE as Backend
  participant IdP

  UI->>Popup: open popup to about:blank (synchronous, or browsers block window.open)
  UI->>BE: POST oidc/verify-session {provider_id} (admin session)
  BE->>BE: mint ticket — random token = PK of a new oidc_verify_ticket row, bound to admin + provider, 10-min TTL
  BE-->>UI: {correlation_id, login_url, expires_at}
  UI->>Popup: navigate popup to login_url (test=true, corr=correlation_id)
  Popup->>BE: GET oidc/login (test=true, corr=correlation_id)
  BE->>BE: redeem ticket (single-use: 400 if unknown, already redeemed, expired, or wrong provider)
  Popup->>IdP: real login (admin credentials + MFA)
  IdP-->>Popup: redirect back with auth code
  Popup->>BE: callback: verify login (no session created)
  BE->>BE: store result under correlation_id (5 min, single-use insert — the id cannot already be occupied)
  BE-->>Popup: redirect to blank page
  Popup->>Popup: close itself
  loop UI polls every 1.5s (up to 6 min)
    UI->>BE: fetch result by correlation id (admin session)
    BE-->>UI: 404 ticket gone/expired (stop), 204 ticket alive/no result yet (keep polling), or 200 the result (ticket + result then deleted)
  end
  UI->>UI: show success/failure + claims preview

scenario "test a provider before saving it" { speed: 1.0 }

  step open "The popup opens before there is anything to show" {
    desc: "This is first for a reason that has nothing to do with OIDC. A popup only survives if window.open runs inside the click that caused it, so the page opens a blank one immediately and fetches the URL afterwards. Wait for the round trip and the browser blocks the window."
    flow UI -> Popup { dur: 600ms, msg: 1 }
    note Popup "about:blank —\nopened synchronously\nor not at all" { side: below }
  }

  step ticket "The backend mints a single-use ticket" {
    desc: "The ticket is the primary key of a new row, bound to this admin and this provider, and good for ten minutes. Making the random token the key rather than a column is what lets redemption be one atomic statement later — there is no window in which two requests both believe they claimed it."
    seq {
      flow UI -> BE { dur: 700ms, msg: 1 }
      flow BE -> BE { dur: 700ms, msg: 1 }
    }
    highlight BE { style: busy }
    set BE { badge: "ticket issued", state: pending, color: "#7c3aed" }
    gauge BE { label: "ticket TTL", value: "10 min" }
  }

  step handoff "The URL comes back and the blank popup is pointed at it" {
    desc: "The correlation id travels with the login URL, which is what makes the whole thing traceable: the popup, the callback and the polling all name the same attempt without any of them sharing a session."
    seq {
      flow BE -> UI { dur: 500ms, style: response, msg: 1 }
      flow UI -> Popup { dur: 500ms, msg: 2 }
    }
  }

  step redeem "Redeeming the ticket is where the checks live" {
    desc: "The login URL has left the admin's session — the popup arrives with no cookie of its own — so the ticket has to carry the authority instead. Unknown, already redeemed, expired or belonging to a different provider all fail identically with a 400, and a leaked URL is worth exactly one attempt."
    seq {
      flow Popup -> BE { dur: 600ms, msg: 1 }
      flow BE -> BE { dur: 700ms, msg: 2 }
    }
    highlight BE { style: busy }
    set BE { badge: "ticket redeemed", state: active, color: "#7c3aed" }
  }

  step login "A real login, against the real IdP" {
    desc: "Admin credentials, real MFA, the provider's actual policies. This is the part no cheaper check can stand in for: a discovery document can be perfect while the client secret is wrong, the redirect URI is unregistered, or a conditional-access rule quietly refuses this application."
    focus Popup
    seq {
      flow Popup -> IdP { dur: 900ms }
      flow IdP -> Popup { dur: 700ms, style: response }
    }
    note IdP "the same provider\nproduction logins\nwill use" { side: below }
  }

  step discard "The callback verifies everything and grants nothing" {
    desc: "The code is exchanged and the token verified exactly as a real login would, and then no session is created. That deliberate omission is what makes this safe to run from a settings page: the strongest possible evidence the configuration works, and no new way in if it does."
    flow Popup -> BE { dur: 700ms, msg: 2 }
    set BE { badge: "verified, no session", state: ok, color: "#16a34a" }
    note BE "everything a login does\nexcept the part that\nlets you in" { side: below }
  }

  step park "The result is parked under the correlation id" {
    desc: "Two browsing contexts that cannot call each other, so the answer goes through the server. The insert is single-use — the id cannot already be occupied — which rules out a second attempt overwriting a result the settings page has not read yet."
    seq {
      flow BE -> BE { dur: 700ms, msg: 3 }
      flow BE -> Popup { dur: 500ms, style: response }
    }
    gauge BE { label: "result", value: "stored, 5 min" }
  }

  step close "The popup closes itself" {
    desc: "It landed on a blank page it opened with, so there is nothing to leave behind and nobody to leave it for. From here the settings page is the only participant that has not finished."
    flow Popup -> Popup { dur: 600ms }
    dim Popup { delay: 600ms, dur: 600ms }
    highlight UI { style: active }
  }

  step poll "The settings page asks, every second and a half" {
    desc: "Three answers, and each ends the loop differently: 404 means the ticket is gone and there will never be a result, 204 means keep asking, 200 hands the result over and deletes both rows. Without the 404 a cancelled login would poll for the full six minutes and then time out on a question that was already settled."
    focus UI
    seq {
      flow UI -> BE { dur: 500ms, msg: 2 }
      flow BE -> UI { dur: 500ms, style: response, msg: 2 }
    }
    gauge UI { label: "poll", value: "1.5s · 6 min cap" }
  }

  step show "The admin sees the claims that came back" {
    desc: "Success is not a green tick — it is the claims preview. Half of what goes wrong with a new provider is a login that works perfectly and returns a username or a groups claim under a name the mapping does not expect, and that is only visible if you print what arrived."
    flow UI -> UI { dur: 700ms }
    highlight UI { color: "#16a34a" }
    unset BE
    set UI { badge: "claims preview", state: ok, color: "#16a34a" }
  }
